# Copy to /etc/apofika.env and adjust.
APOFIKA_HOME=/home/pknapp/ApoFiKaSplit

# Public base URL as seen by podcast apps / Overcast
SPLITCASTS_PUBLIC_BASE=https://splitcasts.peterknapp.de
APOFIKA_PUBLIC_BASE=https://splitcasts.peterknapp.de

APOFIKA_HOST=0.0.0.0
APOFIKA_PORT=8787

# Admin login — prefer hash from: apofika hash-password
# SPLITCASTS_PASSWORD_HASH=pbkdf2_sha256$...
SPLITCASTS_PASSWORD=change-me
SPLITCASTS_SESSION_SECRET=change-this-long-random-string
