[Unit]
Description=Splitcasts: process latest episode for all active feeds
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/apofika.env
User=pi
Group=pi
# Nice/ionice: keep the Pi usable while detection runs (can take a long time on 3B)
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Must be process-all (multi-feed). Legacy `process` only hits the old ApoFiKa pipeline.
ExecStart=/bin/bash -lc 'cd "$APOFIKA_HOME" && exec .venv/bin/apofika process-all --public-base "${SPLITCASTS_PUBLIC_BASE:-$APOFIKA_PUBLIC_BASE}"'
